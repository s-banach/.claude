{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/bunbie/.claude/hooks/no-unscoped-search.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking search scope"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/bunbie/.claude/hooks/no-scriptless-file-writes.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking that file-writing code lives in a file"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/bunbie/.claude/hooks/no-python-outside-venv.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking the interpreter against the project venv"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/bunbie/.claude/hooks/no-truncated-search.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking that a search's output is not cut"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
