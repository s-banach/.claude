{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/no-unscoped-search.py\"",
            "timeout": 10,
            "statusMessage": "Checking that the search uses rg with a scope"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/no-python-outside-venv.py\"",
            "timeout": 10,
            "statusMessage": "Checking the interpreter against the project venv"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
