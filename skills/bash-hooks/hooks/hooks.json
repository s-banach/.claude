{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/no-unscoped-search.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking search scope"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/no-unwritten-python.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking for Python file edits"
          }
        ]
      }
    ]
  }
}
