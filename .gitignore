# Track configuration only. Everything else here is session state, cache, or credentials.
# Ignore every path, then re-include each committed file by name.
# `*` also matches files inside a re-included directory, so each file there needs its own line.
*

!.gitignore
!CLAUDE.md
!settings.json

!bin/
!bin/run-check

!agents/
!agents/implementation-reviewer.md
!agents/premise-reviewer.md
!agents/simplicity-reviewer.md

!hooks/
!hooks/hook_testing.py
!hooks/shell_parsing.py
!hooks/bash-rules.py
!hooks/bash_rules_test.py
!hooks/foreground_timeout.py
!hooks/no_python_outside_venv.py
!hooks/no_python_outside_venv_test.py
!hooks/no_grep.py
!hooks/no_grep_test.py
!hooks/no_cd.py
!hooks/no_cd_test.py
!hooks/no_chained_commit.py
!hooks/no_chained_commit_test.py
